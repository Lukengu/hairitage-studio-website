# Local development settings for docker compose.
# Copy to .env.db.local (and .env.local if you use deploy/local-setup.sh) and edit.

DEBUG=1
SECRET_KEY=change-me-for-local-dev
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Django -> Postgres
DATABASE=postgres
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=hairitage
SQL_USER=hairitage
SQL_PASSWORD=change-me
SQL_HOST=db
SQL_PORT=5432

# Postgres container
POSTGRES_USER=hairitage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hairitage

# Optional integrations (leave blank to disable)
EMAIL_HOST_PASSWORD=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GOOGLE_MAPS_API_KEY=
